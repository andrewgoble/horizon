{
  "permissions": {
    "deny": [
      "Bash(shopify theme publish:*)",
      "Bash(shopify theme push:*)",
      "Bash(shopify theme delete:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rebrand-guard.sh\"" }
        ]
      }
    ]
  }
}
